# ---------------------------------------------------------------------------
# Local development configuration. Copy to `.env` (`make up` does it for you).
#
# These are LOCAL-ONLY credentials for containers that are not reachable from
# outside the compose network. Nothing here is a real secret, and nothing here
# is used on AWS: see docs/aws-mapping.md for what each variable becomes there.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=pmp
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=json

# Public origin the browser uses. Everything is served through the edge.
PUBLIC_BASE_URL=http://localhost:8080
EDGE_HTTP_PORT=8080

# ------------------------------------------------------------------ postgres
POSTGRES_DB=pmtiles
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-postgres-password

# Per-service roles, created by the `migrate` one-shot container.
AUTH_DB_PASSWORD=local-auth-password
BACKEND_DB_PASSWORD=local-backend-password
WORKER_DB_PASSWORD=local-worker-password

DB_HOST=postgres
DB_PORT=5432
DB_NAME=pmtiles
DB_SSLMODE=disable
# password | iam  (iam = RDS IAM auth tokens; not used locally)
DB_AUTH=password

# --------------------------------------------------------------------- kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# none | aws-msk-iam  (aws-msk-iam is a stub for MSK; not used locally)
KAFKA_SASL_MECHANISM=none
KAFKA_TOPIC_PUBLICATION_REQUESTED=publication.requested
KAFKA_TOPIC_PUBLICATION_RESULTS=publication.results
KAFKA_TOPIC_PUBLICATION_DLQ=publication.requested.dlq
KAFKA_TOPIC_PARTITIONS=6
KAFKA_CONSOLE_PORT=8081

# ------------------------------------------------------------------------ s3
# Unset S3_ENDPOINT / S3_*_KEY on AWS to use the regional endpoint and the
# default credential chain (EKS Pod Identity).
S3_ENDPOINT=http://s3:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_STAGING_BUCKET=staging
S3_PUBLISH_BUCKET=publish

# MinIO root credentials (used only by the s3-init job).
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=local-minio-root-password
MINIO_CONSOLE_PORT=9011

# Scoped access keys created by s3-init, one per service.
BACKEND_S3_ACCESS_KEY=backend-access-key
BACKEND_S3_SECRET_KEY=local-backend-s3-secret
WORKER_S3_ACCESS_KEY=worker-access-key
WORKER_S3_SECRET_KEY=local-worker-s3-secret

# --------------------------------------------------------------------- backend
# internal_jwt (real) | dev_stub (phase-1 development only; refuses to start
# unless ENVIRONMENT=local, and runs every request as a fixed identity).
BACKEND_AUTH_MODE=internal_jwt
BACKEND_DEV_USER_ID=dev-user
BACKEND_DEV_TENANT_ID=dev-tenant

# ---------------------------------------------------------------- auth + gateway
AUTH_BASE_URL=http://auth:3000
BACKEND_BASE_URL=http://backend:8000
GATEWAY_BASE_URL=http://gateway:8000
EDGE_VERIFIER_BASE_URL=http://edge-verifier:8000

# Successful identity verifications are cached this long. It is also the upper
# bound on how long a revoked session keeps working against the API.
GATEWAY_VERIFY_CACHE_TTL=10
GATEWAY_RATE_LIMIT_RPS=20
GATEWAY_RATE_LIMIT_BURST=40

# Keys generated by scripts/gen-dev-keys.sh into ./dev-keys (gitignored).
# On AWS these paths are mounted from Secrets Manager instead.
INTERNAL_JWT_PRIVATE_KEY_PATH=/run/keys/internal-jwt.key
INTERNAL_JWT_PUBLIC_KEY_PATH=/run/keys/internal-jwt.pub
CLOUDFRONT_PRIVATE_KEY_PATH=/run/keys/cloudfront.key
CLOUDFRONT_PUBLIC_KEY_PATH=/run/keys/cloudfront.pub
CLOUDFRONT_KEY_PAIR_ID=LOCALKEYPAIRID
BETTER_AUTH_SECRET_PATH=/run/keys/better-auth.secret

TILE_COOKIE_TTL_SECONDS=600

# ---------------------------------------------------------------------- worker
WORKER_LEASE_SECONDS=300
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_BASE_SECONDS=2
WORKER_RECONCILER_INTERVAL_SECONDS=30
WORKER_STUCK_PENDING_SECONDS=60
WORKER_OUTBOX_INTERVAL_SECONDS=1
WORKER_OUTBOX_BATCH=100

# Chaos switches — off by default, logged loudly when on. See README.
CHAOS_CRASH_AFTER_COPY=0
CHAOS_CRASH_BEFORE_OFFSET_COMMIT=0
CHAOS_DELAY_MS=0

# ------------------------------------------------------------------------ demo
# Presigned browser uploads. Off by default; the demo page needs it.
DEMO_UPLOAD_ENABLED=true

# ----------------------------------------------------------- observability
# Unset to disable trace export entirely (the default outside the profile).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
GRAFANA_PORT=3001
JAEGER_UI_PORT=16686
GRAFANA_ADMIN_PASSWORD=admin
