# ---------------------------------------------------------------------------
# Local development configuration. Copy to `.env` (`make up` does it for you).
#
# These are LOCAL-ONLY credentials for containers that are not reachable from
# outside the compose network. Nothing here is a real secret. Every other
# setting has a default in docker-compose.yml; override it here if needed.
# See docs/aws-mapping.md for what changes on AWS.
# ---------------------------------------------------------------------------

# ------------------------------------------------------------------ postgres
POSTGRES_PASSWORD=local-postgres-password
# Per-service roles, created by the `migrate` one-shot container.
AUTH_DB_PASSWORD=local-auth-password
BACKEND_DB_PASSWORD=local-backend-password
WORKER_DB_PASSWORD=local-worker-password

# ------------------------------------------------------------------------ s3
# MinIO root credentials (used only by the s3-init job).
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=local-minio-root-password
# Scoped access keys created by s3-init, one per service.
BACKEND_S3_ACCESS_KEY=backend-access-key
BACKEND_S3_SECRET_KEY=local-backend-s3-secret
WORKER_S3_ACCESS_KEY=worker-access-key
WORKER_S3_SECRET_KEY=local-worker-s3-secret

# ---------------------------------------------------------------------- knobs
# Presigned browser uploads (upload.html). Off by default in compose.
DEMO_UPLOAD_ENABLED=true
# Successful identity verifications are cached this long; it is also the upper
# bound on how long a revoked session keeps working against the API.
GATEWAY_VERIFY_CACHE_TTL=10
# Gateway rate limits are per route class, in services/gateway/routes.yaml.

# Chaos switches — off by default, logged loudly when on. See README.
CHAOS_CRASH_AFTER_COPY=0
CHAOS_CRASH_BEFORE_OFFSET_COMMIT=0
CHAOS_DELAY_MS=0

# `make up PROFILE=observability` sets these for you.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# EDGE_OTEL_TRACE=on
GRAFANA_ADMIN_PASSWORD=admin
