{
  "$defs": {
    "ErrorCode": {
      "description": "Stable, machine-readable failure reasons recorded on a job.\n\n``PERMANENT_*`` codes never retry; anything else is treated as transient by\nthe worker and retried with backoff before being dead-lettered.",
      "enum": [
        "SOURCE_NOT_FOUND",
        "SOURCE_FORBIDDEN",
        "TENANT_MISMATCH",
        "INVALID_PMTILES",
        "UNSUPPORTED_PMTILES_VERSION",
        "EMPTY_SOURCE",
        "DATASET_NOT_FOUND",
        "STORAGE_ERROR",
        "DATABASE_ERROR",
        "MAX_ATTEMPTS_EXCEEDED",
        "INTERNAL_ERROR"
      ],
      "title": "ErrorCode",
      "type": "string"
    }
  },
  "$id": "https://pmtiles.platform/events/publication.failed/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempts": {
      "minimum": 1,
      "title": "Attempts",
      "type": "integer"
    },
    "dataset_id": {
      "description": "Dataset the event is about; also the partition key.",
      "format": "uuid",
      "title": "Dataset Id",
      "type": "string"
    },
    "dead_lettered": {
      "default": false,
      "title": "Dead Lettered",
      "type": "boolean"
    },
    "error_code": {
      "$ref": "#/$defs/ErrorCode"
    },
    "error_message": {
      "maxLength": 2000,
      "title": "Error Message",
      "type": "string"
    },
    "event_id": {
      "description": "Unique id of this event; consumers deduplicate on it.",
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "publication.failed",
      "default": "publication.failed",
      "title": "Event Type",
      "type": "string"
    },
    "job_id": {
      "description": "Publication job the event belongs to.",
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "const": "FAILED",
      "default": "FAILED",
      "title": "Status",
      "type": "string"
    },
    "tenant_id": {
      "description": "Owning organization id.",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "dataset_id",
    "job_id",
    "error_code",
    "error_message",
    "attempts"
  ],
  "title": "PublicationFailed",
  "type": "object"
}
